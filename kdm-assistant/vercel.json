{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {"main": false, "rules-v2": false}
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/index?route=$1"}
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{data/pages/**,data/history.sqlite3,test_*.py,__pycache__/**}"
    }
  }
}
